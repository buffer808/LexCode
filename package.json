{
  "name": "lex-code",
  "displayName": "LexCode",
  "description": "Agile project manager for concurrent projects with Claude Code sessions",
  "version": "0.0.5",
  "publisher": "lex",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/buffer808/LexCode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "bin": {
    "lexcode": "out/cli.js"
  },
  "activationEvents": [
    "onWebviewPanel:lexCode.dashboard",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lexCode",
          "title": "LexCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "lexCode": [
        {
          "id": "lexCode.board",
          "name": "Board"
        }
      ]
    },
    "commands": [
      {
        "command": "lexCode.addProject",
        "title": "LexCode: Add Project",
        "icon": "$(add)"
      },
      {
        "command": "lexCode.removeProject",
        "title": "LexCode: Remove Project",
        "icon": "$(trash)"
      },
      {
        "command": "lexCode.refresh",
        "title": "LexCode: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "lexCode.openProject",
        "title": "LexCode: Open Project in Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "lexCode.openAllProjects",
        "title": "LexCode: Open All Projects in Workspace",
        "icon": "$(folder-library)"
      },
      {
        "command": "lexCode.newEpic",
        "title": "LexCode: New Epic",
        "icon": "$(layers)"
      },
      {
        "command": "lexCode.runFactory",
        "title": "LexCode: Run Software Factory on Epic",
        "icon": "$(rocket)"
      },
      {
        "command": "lexCode.openPlan",
        "title": "LexCode: Open Factory Plan",
        "icon": "$(book)"
      },
      {
        "command": "lexCode.newSprint",
        "title": "LexCode: New Sprint",
        "icon": "$(milestone)"
      },
      {
        "command": "lexCode.startSprint",
        "title": "LexCode: Start Sprint",
        "icon": "$(play)"
      },
      {
        "command": "lexCode.newStory",
        "title": "LexCode: New Story",
        "icon": "$(add)"
      },
      {
        "command": "lexCode.editStory",
        "title": "LexCode: Edit Story",
        "icon": "$(edit)"
      },
      {
        "command": "lexCode.setStatus",
        "title": "LexCode: Set Status",
        "icon": "$(check)"
      },
      {
        "command": "lexCode.deleteItem",
        "title": "LexCode: Delete",
        "icon": "$(trash)"
      },
      {
        "command": "lexCode.resumeSession",
        "title": "LexCode: Resume Claude Session",
        "icon": "$(history)"
      },
      {
        "command": "lexCode.claudeStory",
        "title": "LexCode: Open Claude Session",
        "icon": "$(sparkle)"
      },
      {
        "command": "lexCode.attachStory",
        "title": "LexCode: Attach to Background Run",
        "icon": "$(terminal)"
      },
      {
        "command": "lexCode.importTasks",
        "title": "LexCode: Import Tasks from TASKS.md",
        "icon": "$(cloud-download)"
      },
      {
        "command": "lexCode.syncTasks",
        "title": "LexCode: Sync from TASKS.md",
        "icon": "$(sync)"
      },
      {
        "command": "lexCode.dashboard",
        "title": "LexCode: Open Dashboard",
        "icon": "$(dashboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lexCode.dashboard",
          "when": "view == lexCode.board",
          "group": "navigation"
        },
        {
          "command": "lexCode.addProject",
          "when": "view == lexCode.board",
          "group": "navigation"
        },
        {
          "command": "lexCode.openAllProjects",
          "when": "view == lexCode.board",
          "group": "navigation"
        },
        {
          "command": "lexCode.refresh",
          "when": "view == lexCode.board",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lexCode.attachStory",
          "when": "viewItem == 'story live'",
          "group": "inline@1"
        },
        {
          "command": "lexCode.claudeStory",
          "when": "viewItem =~ /^story/ && viewItem != 'story live'",
          "group": "inline@1"
        },
        {
          "command": "lexCode.setStatus",
          "when": "viewItem =~ /^story/",
          "group": "inline@2"
        },
        {
          "command": "lexCode.editStory",
          "when": "viewItem =~ /^story/",
          "group": "inline@3"
        },
        {
          "command": "lexCode.deleteItem",
          "when": "viewItem =~ /^story/",
          "group": "9"
        },
        {
          "command": "lexCode.openProject",
          "when": "viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "lexCode.newEpic",
          "when": "viewItem == project",
          "group": "inline@2"
        },
        {
          "command": "lexCode.newSprint",
          "when": "viewItem == project",
          "group": "inline@3"
        },
        {
          "command": "lexCode.newStory",
          "when": "viewItem == project",
          "group": "inline@4"
        },
        {
          "command": "lexCode.importTasks",
          "when": "viewItem == project",
          "group": "8"
        },
        {
          "command": "lexCode.syncTasks",
          "when": "viewItem == project",
          "group": "8"
        },
        {
          "command": "lexCode.removeProject",
          "when": "viewItem == project",
          "group": "inline@9"
        },
        {
          "command": "lexCode.newStory",
          "when": "viewItem =~ /^(epic|noEpic|sprint|backlog)$/",
          "group": "inline@2"
        },
        {
          "command": "lexCode.startSprint",
          "when": "viewItem == sprint",
          "group": "inline@1"
        },
        {
          "command": "lexCode.deleteItem",
          "when": "viewItem =~ /^(sprint|epic)$/",
          "group": "9"
        },
        {
          "command": "lexCode.runFactory",
          "when": "viewItem == epic",
          "group": "1"
        },
        {
          "command": "lexCode.openPlan",
          "when": "viewItem == epic",
          "group": "1"
        }
      ],
      "commandPalette": [
        {
          "command": "lexCode.startSprint",
          "when": "false"
        },
        {
          "command": "lexCode.editStory",
          "when": "false"
        },
        {
          "command": "lexCode.setStatus",
          "when": "false"
        },
        {
          "command": "lexCode.deleteItem",
          "when": "false"
        },
        {
          "command": "lexCode.resumeSession",
          "when": "false"
        },
        {
          "command": "lexCode.claudeStory",
          "when": "false"
        },
        {
          "command": "lexCode.attachStory",
          "when": "false"
        },
        {
          "command": "lexCode.runFactory",
          "when": "false"
        },
        {
          "command": "lexCode.openPlan",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "LexCode",
      "properties": {
        "lexCode.claudeLauncher": {
          "type": "string",
          "enum": [
            "auto",
            "cli"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Claude Code extension if installed, else CLI",
            "Always claude CLI in a terminal"
          ]
        },
        "lexCode.backgroundPermissionMode": {
          "type": "string",
          "enum": [
            "manual",
            "acceptEdits",
            "plan",
            "auto",
            "bypassPermissions"
          ],
          "default": "manual",
          "enumDescriptions": [
            "Pause and wait for you to approve (Attach)",
            "Auto-approve file edits; ask for commands",
            "Read-only planning",
            "Claude decides what is safe",
            "Skip all permission checks (dangerous)"
          ],
          "description": "Default permission mode for background Claude runs"
        },
        "lexCode.tasksScanSkip": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "out",
            "dist",
            "build",
            ".next",
            "vendor",
            ".venv",
            "target"
          ],
          "description": "Folder names skipped when scanning a project for TASKS.md. Remove an entry to scan it; empty list scans everything"
        },
        "lexCode.claudePath": {
          "type": "string",
          "default": "",
          "description": "Path to the claude CLI (auto-detected if empty)"
        },
        "lexCode.factory.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "New epics start the software factory: plan → revalidate → security check → your approval. Off: New Epic only creates the epic."
        },
        "lexCode.factory.builderPermissionMode": {
          "type": "string",
          "enum": [
            "acceptEdits",
            "auto"
          ],
          "default": "acceptEdits",
          "enumDescriptions": [
            "Accept edits: builders auto-approve file edits and pause for shell command approvals",
            "Full auto: builders run unattended (Claude Code auto mode)"
          ],
          "description": "Builder mode preselected when creating a factory epic"
        },
        "lexCode.factory.targetBranch": {
          "type": "string",
          "default": "main",
          "description": "Default pull request target branch for factory epics"
        },
        "lexCode.factory.models": {
          "type": "object",
          "default": {
            "planner": {
              "model": "opus",
              "effort": "high"
            },
            "builder": {},
            "reviewer": {}
          },
          "description": "Model and effort per factory role: planner (plan, revalidate, security), builder, reviewer. model: alias (opus, sonnet, haiku, fable) or full id; effort: low|medium|high|xhigh|max. Empty = Claude default. A project agent's own frontmatter model wins over this; a per-epic choice wins over both.",
          "properties": {
            "planner": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              }
            },
            "builder": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              }
            },
            "reviewer": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        "lexCode.factory.defaultWorkers": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 8,
          "description": "Builders preselected when starting a factory build. Parallel-safe sprints run side by side in separate git worktrees, up to this many."
        },
        "lexCode.factory.maxReviewAttempts": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "Review failures per story (or sprint) before the factory stops and asks you to retry, take over or skip."
        },
        "lexCode.factory.sensitivePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/auth/**",
            "**/migrations/**",
            ".github/**",
            "package.json",
            "*lock*",
            "**/*.env*",
            "Dockerfile"
          ],
          "description": "Gitignore-style globs. A sprint that changes a matching file waits for your approval before merging into the epic branch."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "prepare": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.4.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  }
}
